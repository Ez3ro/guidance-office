# Copy to .env for local development. Never commit .env.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite locally. On Vercel use the Supabase *transaction pooler*
# URL (port 6543) for the dedicated app role created by supabase/setup.sql, e.g.
# postgresql://guidance_app.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Set to false for a local Postgres without SSL.
DB_SSL_REQUIRE=true

# Encrypts counseling notes, case narratives and other confidential fields.
# Generate with: python manage.py generate_encryption_key
# Comma-separated; the first key encrypts, all keys decrypt (for rotation).
# LOSING THIS KEY MEANS LOSING THE ENCRYPTED DATA. Keep a copy in a password manager.
FIELD_ENCRYPTION_KEYS=

SITE_NAME=Guidance Office Management System

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Supabase Storage (S3 protocol) for attachments. Leave empty locally to store files in ./media
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Email for follow-up reminders (optional; prints to the console when unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=guidance-office@example.com

# Minutes of inactivity before a user is signed out
SESSION_IDLE_TIMEOUT_MINUTES=30
